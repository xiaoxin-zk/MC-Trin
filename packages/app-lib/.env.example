# Copy this file to `.env` (ignored by git) before building locally.
# A key set here is compiled into the launcher, so CurseForge works without
# asking the player for a key. Never commit the real value and never put it in
# the repository; CI reads it from the CURSEFORGE_API_KEY Actions secret.
CURSEFORGE_API_KEY=

# Optional: gives this build its own data directory, isolated from the data
# directory of an installed launcher. The previous name
# AXOLOTL_DATA_DIR_SUFFIX is still accepted.
# MCTRIN_DATA_DIR_SUFFIX=
